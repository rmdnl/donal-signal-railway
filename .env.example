# =====================================================
# DONAL Signal Bot VPS -- .env.example
# Copy file ini jadi .env lalu isi sesuai kebutuhan:
#   cp .env.example .env
# JANGAN commit file .env (isinya token/secret) ke Git.
# =====================================================

# --- Symbols & Timeframe ---
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT
TIMEFRAME=1h
HTF_TIMEFRAME=4h

# --- Indikator dasar ---
ATR_LENGTH=14
RSI_LENGTH=14
SL_MULT=1.5
TP_MULT=2.5
MIN_RISK_REWARD=1.0
RSI_ENTRY=50
RSI_EXIT=45

# --- Support/Resistance & Structure SL/TP (mengikuti Pine) ---
SR_LEFT_BARS=10
SR_RIGHT_BARS=10
USE_RES_FILTER=true
MIN_ROOM_ATR=1.0
USE_STRUCTURE_SLTP=true
SR_BUFFER_ATR=0.3

# --- Volume filter (enhancement, bukan bagian dari Pine asli) ---
USE_VOLUME_FILTER=true
VOLUME_MA_LENGTH=20
VOLUME_MULT=1.0

# --- Volatility-scaled SL/TP (enhancement, bukan bagian dari Pine asli) ---
USE_VOL_SCALED_SLTP=true
ATR_MA_LENGTH=50
VOL_SCALE_MIN=0.8
VOL_SCALE_MAX=1.5

# --- Exposure & Correlation Guard (enhancement, bukan bagian dari Pine asli) ---
# 0 = unlimited untuk MAX_CONCURRENT_POSITIONS / MAX_POSITIONS_PER_GROUP
MAX_CONCURRENT_POSITIONS=2
MAX_POSITIONS_PER_GROUP=1
# Format: grup dipisah ";", pair dalam satu grup dipisah ","
# [CATATAN AUDIT] Default di bawah ini menaruh KESEMPAT pair default (BTC, ETH,
# SOL, BNB) dalam SATU grup korelasi yang sama, dengan MAX_POSITIONS_PER_GROUP=1.
# Efeknya: walau MAX_CONCURRENT_POSITIONS=2, bot pada praktiknya HANYA akan
# pernah membuka 1 posisi dalam satu waktu (karena batas per-grup lebih ketat
# dan semua symbol default ada di grup yang sama). Ini sah-sah saja kalau memang
# itu yang diinginkan (konservatif), tapi kalau ingin benar-benar sampai 2 posisi
# bersamaan, pisahkan jadi 2 grup, contoh:
#   CORRELATED_GROUPS=BTC/USDT,ETH/USDT;SOL/USDT,BNB/USDT
CORRELATED_GROUPS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT

# --- Session filter (enhancement, bukan bagian dari Pine asli) ---
# Jam dalam UTC. Contoh 8-22 UTC = hindari sesi Asia paling sepi.
SESSION_FILTER_ENABLED=true
SESSION_START_HOUR=8
SESSION_END_HOUR=22

# --- Trading fee ---
# Fee per sisi transaksi (%). Dipakai untuk hitung PnL net dan breakeven price
# di alert Telegram. Default = taker fee standar Binance Spot.
# Ganti ke 0.075 kalau pakai diskon BNB.
TAKER_FEE_PCT=0.1

# =====================================================
# AUTO TRADING (Binance API) -- opsional
# =====================================================
# off     = signal-only, TIDAK ada order nyata (default, aman)
# testnet = order sungguhan ke Binance Spot Testnet (uang virtual)
# live    = order sungguhan ke akun asli (UANG BENERAN -- hati-hati!)
TRADING_MODE=off

# Testnet API key: generate di https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Live API key: AKTIFKAN HANYA izin "Spot Trading". WITHDRAWAL HARUS MATI.
# Jangan pernah commit key asli ke file ini / ke git.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

QUOTE_ASSET=USDT

# Risk-based sizing: qty = (saldo_USDT * RISK_PCT_PER_TRADE%) / (entry - SL)
RISK_PCT_PER_TRADE=1.0
# Hard ceiling for risk measured from actual fill to actual SL. 0 = disabled.
MAX_ACTUAL_RISK_PCT=1.25
# If actual risk exceeds the ceiling: reduce = sell only excess size; exit = close all; hold = keep + alert.
RISK_OVERSHOOT_ACTION=reduce

# Entry & exit pakai MARKET order (kepastian eksekusi, bukan presisi harga).
# MAX_ENTRY_SLIPPAGE_PCT = guard PRE-TRADE khusus entry: kalau estimasi slippage
# (ask sekarang vs harga referensi sinyal) melebihi ini, entry DIBATALKAN sebelum
# order dikirim. 0 = nonaktif (selalu entry berapa pun slippage-nya).
# Tidak ada guard serupa untuk exit -- SL/TP/trend-exit harus selalu jalan demi
# risk management, slippage-nya cuma dilaporkan lewat Telegram, tidak membatalkan exit.
MAX_ENTRY_SLIPPAGE_PCT=0.5

# Native Binance OCO (One-Cancels-the-Other): SL/TP disimpan DI EXCHANGE, tetap aktif
# walau bot mati/koneksi putus. Status UNKNOWN tidak dianggap gagal dan tidak
# memicu blind retry. Jika OCO definitively absent/invalid, bot melakukan emergency exit.
# WAJIB divalidasi di testnet sebelum LIVE.
USE_NATIVE_OCO_SLTP=true

# Daily/weekly loss limit (circuit breaker): begitu rugi net (setelah fee) di periode
# berjalan menyentuh batas ini, ENTRY BARU diblokir sampai periode berikutnya (UTC).
# Posisi yang SUDAH terbuka TIDAK dipaksa tutup -- SL/TP/trend-exit tetap jalan normal.
# TRADING_MODE testnet/live: dihitung dari saldo riil (akurat).
# TRADING_MODE off (signal-only): dihitung dari akumulasi %PnL virtual (pendekatan).
# 0 = nonaktif.
DAILY_LOSS_LIMIT_PCT=3.0
WEEKLY_LOSS_LIMIT_PCT=6.0

# --- Loop & candle confirmation ---
LOOP_INTERVAL_SECONDS=30
CANDLE_CONFIRM_OFFSET_SEC=5

# --- Perilaku sinyal ---
TRACK_SL_TP=true
SEND_TREND_EXIT=true
ENTRY_ON_FIRST_RUN=false
MAX_ENTRY_DELAY_MINUTES=15

# --- Telegram ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ERRORS=true

# --- State & VPS ---
# Gunakan path persisten di VPS. Contoh: /opt/donal-signal/state_signals.json
STATE_FILE=state_signals.json
HISTORY_FILE=trade_history.json
# VPS: kosongkan/0 kalau health server tidak diperlukan
PORT=0

# --- Break-Even (BE) Protection ---
# Geser SL ke harga modal kalau posisi sudah profit menyentuh persentase tertentu.
USE_BREAK_EVEN=true
BE_TRIGGER_PCT=1.0    # Trigger BE saat profit >= 1%
BE_OFFSET_PCT=0.15    # SL baru = Entry + 0.15% (untuk cover fee exchange)

# --- ADX Filter (Trend Strength) ---
USE_ADX_FILTER=true
ADX_LENGTH=14
ADX_THRESHOLD=20.0
